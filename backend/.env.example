# ---------- Server ----------
PORT=5055
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ---------- Database (MongoDB Atlas) ----------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vehicle_breakdown?retryWrites=true&w=majority

# ---------- Auth ----------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Dispatch ----------
# Seconds a driver has to accept a job offer before it moves to the next driver
OFFER_TIMEOUT_SECONDS=60
# How many drivers to try before alerting the admin
MAX_DISPATCH_ATTEMPTS=5
# Search radius for nearby drivers (km)
DISPATCH_RADIUS_KM=25

# ---------- Routing / ETA (free OSRM public server) ----------
OSRM_URL=https://router.project-osrm.org

# ---------- Share link ----------
# Hours a share link stays valid after the job finishes
SHARE_TOKEN_GRACE_HOURS=1

# ---------- Seed data ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123


# ---------- Payments (Razorpay) ----------
# Production notes:
# - In production, replace rzp_test_* with your live Key ID (rzp_live_*) from Razorpay Dashboard -> Settings -> API Keys.
# - Keep RAZORPAY_KEY_SECRET confidential; never commit real secrets to source control.
# - RAZORPAY_WEBHOOK_SECRET: Secret configured in Razorpay Dashboard -> Webhooks for validating incoming webhook signatures.
# - FRONTEND_URL: Base URL of your deployed frontend (e.g., https://yourdomain.com), used for payment links and QR codes on receipts (no trailing slash).
# - For testing in development, use Razorpay test Key ID and Secret with test card 4111 1111 1111 1111 (any future MM/YY, any 3-digit CVV).
# - Payment gateway configuration health can be checked via GET /api/payments/health.
# - UPI_ID and UPI_PAYEE_NAME: Used for fallback manual UPI QR code generation if Razorpay QR is disabled.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose_any_string
FRONTEND_URL=http://localhost:5173
UPI_ID=breakdownassistant@upi
UPI_PAYEE_NAME=Vehicle Breakdown Assistant
